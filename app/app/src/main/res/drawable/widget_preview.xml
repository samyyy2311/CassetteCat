        android:drawable="@drawable/ic_widget_play" />
    <item
        android:width="48dp"
        android:height="48dp"
        android:left="204dp"
        android:top="58dp"
        android:drawable="@drawable/bg_widget_button" />
    <item
        android:width="18dp"
        android:height="18dp"
        android:left="219dp"
        android:top="73dp"
        android:drawable="@drawable/ic_widget_next" />
</layer-list>
