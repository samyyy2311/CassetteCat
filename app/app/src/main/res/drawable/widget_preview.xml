<?xml version="1.0" encoding="utf-8"?>
<!-- The widget as it looks with nothing playing, for widget pickers before Android 12, which can't show previewLayout.
     Positions follow layout/widget_cassette.xml at its 264 x 120dp minimum size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="264dp"
        android:height="120dp"
        android:drawable="@drawable/bg_cassette_widget" />
    <item
        android:width="72dp"
        android:height="72dp"
        android:left="12dp"
        android:top="24dp"
        android:drawable="@drawable/bg_cassette_window" />
    <item
        android:width="72dp"
        android:height="72dp"
        android:left="12dp"
        android:top="24dp"
        android:drawable="@drawable/cat_black_cassette" />
    <item
        android:width="48dp"
        android:height="48dp"
        android:left="96dp"
        android:top="58dp"
        android:drawable="@drawable/bg_widget_button" />
    <item
        android:width="18dp"
        android:height="18dp"
        android:left="111dp"
        android:top="73dp"
        android:drawable="@drawable/ic_widget_prev" />
    <item
        android:width="52dp"
        android:height="52dp"
        android:left="148dp"
        android:top="56dp"
