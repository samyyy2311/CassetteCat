        android:width="38dp"
        android:height="38dp"
        android:left="144dp"
        android:top="60dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#C23B30" />
        </shape>
    </item>
    <item
        android:width="16dp"
        android:height="16dp"
        android:left="155dp"
        android:top="71dp"
        android:drawable="@drawable/ic_widget_play" />
    <item
        android:width="32dp"
        android:height="32dp"
        android:left="192dp"
        android:top="63dp"
        android:drawable="@drawable/bg_widget_button" />
    <item
        android:width="14dp"
        android:height="14dp"
        android:left="201dp"
        android:top="72dp"
        android:drawable="@drawable/ic_widget_next" />
</layer-list>
